<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/infoUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/infoOfUser"
        android:textSize="20sp"
        android:layout_marginTop="70dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/familia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/infoUser"
        android:hint="Фамилия"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <EditText
        android:id="@+id/name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/familia"
        android:hint="Имя"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <EditText
        android:id="@+id/age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/name"
        android:hint="Возраст"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <EditText
        android:id="@+id/address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/age"
        android:hint="Адрес"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <EditText
        android:id="@+id/phone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/address"
        android:hint="Телефон"
        android:inputType="number"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <EditText
        android:id="@+id/site"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/phone"
        android:hint="Сайт"
        android:inputType="textPersonName"
        android:layout_marginTop="20dp"
        android:clickable="false"
        android:focusable="false"
        />
    <Button
        android:id="@+id/btnEdit"
        android:layout_width="200dp"
        android:layout_height="80dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/site"
        app:layout_constraintStart_toStartOf="@+id/infoUser"
        app:layout_constraintEnd_toEndOf="@+id/infoUser"
        android:text="редактировать"
        />
</androidx.constraintlayout.widget.ConstraintLayout>